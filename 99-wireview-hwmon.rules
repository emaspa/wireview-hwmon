# WireView Pro II udev rules
#
# The uaccess tag gives the user logged in at the local seat an ACL on the
# device node. systemd applies it on hotplug from 73-seat-late.rules, which
# runs before this 99- file and so never sees the tag, so each rule also runs
# the uaccess builtin itself. The tag is still needed: logind uses it to move
# the ACL to the new active session on a user switch.
#
# The serial port keeps the distro's own serial group from
# 50-udev-default.rules (dialout on Debian, Ubuntu and Fedora, uucp on
# Arch-based distros), so this file sets no group on it and installs unchanged
# everywhere. The DFU bootloader is a USB device, which has no serial group by
# default. Its GROUP sits on a line of its own because udev drops a whole rule
# line whose group it cannot resolve: on a distro without dialout only that
# line goes, and the seat ACL still works. The AUR package and "make install"
# replace dialout with uucp on Arch-based distros.

ACTION=="remove", GOTO="wireview_end"

# Serial port (CDC-ACM). wireviewd runs as root and needs nothing here. The
# serial group and the seat user get access so the GUI app can drive the port
# directly without the daemon.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0660", TAG+="uaccess", RUN{builtin}+="uaccess"

# Keep ModemManager away. It treats every new CDC-ACM port as a possible
# modem and probes it with AT and QCDM commands for about half a minute,
# holding the port (wireviewd gets "Device or resource busy") and sending
# the device bytes it does not expect.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0483", ATTR{idProduct}=="5740", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ENV{ID_MM_PORT_IGNORE}="1"

# STM32 DFU bootloader (the device after `wireviewctl bootloader`). Same
# access policy as the serial port, so `wireviewctl flash` can run dfu-util
# as the seat user instead of root.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", MODE="0660", TAG+="uaccess", RUN{builtin}+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", GROUP="dialout"

# /dev/wireview-hwmon needs no rule. Anything that can write to it can inject
# fake sensor readings into hwmon, and the only writer is wireviewd, which
# runs as root. The kernel's default mode for the node (0600 root:root) is
# already the right one.

LABEL="wireview_end"
