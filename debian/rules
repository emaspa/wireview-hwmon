#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	$(CC) -Wall -Wextra -Wno-format-truncation -O2 -o wireviewd wireviewd.c sha256.c
	$(CC) -Wall -Wextra -Wno-format-truncation -O2 -o wireviewctl wireviewctl.c

override_dh_auto_install:
	# Daemon package
	install -D -m 755 wireviewd debian/wireview-hwmon/usr/bin/wireviewd
	install -D -m 755 wireviewctl debian/wireview-hwmon/usr/bin/wireviewctl
	install -D -m 644 debian/wireviewd.service debian/wireview-hwmon/lib/systemd/system/wireviewd.service
	install -D -m 644 99-wireview-hwmon.rules debian/wireview-hwmon/lib/udev/rules.d/99-wireview-hwmon.rules
	install -D -m 644 firmware/TG-WV-PRO2-FW.hex debian/wireview-hwmon/usr/share/wireview/TG-WV-PRO2-FW.hex
	# Reference daemon config (conffile via dh_installdeb; may hold the HMAC secret)
	install -d -m 700 debian/wireview-hwmon/etc/wireview
	install -m 600 wireview-config.sample debian/wireview-hwmon/etc/wireview/config
	# DKMS package
	install -D -m 644 wireview_hwmon.c debian/wireview-hwmon-dkms/usr/src/wireview-hwmon-1.5.1/wireview_hwmon.c
	install -D -m 644 dkms.conf debian/wireview-hwmon-dkms/usr/src/wireview-hwmon-1.5.1/dkms.conf
	install -D -m 644 Makefile.dkms debian/wireview-hwmon-dkms/usr/src/wireview-hwmon-1.5.1/Makefile

# dh_fixperms resets everything to go=rX; restore the private config perms.
override_dh_fixperms:
	dh_fixperms
	if [ -d debian/wireview-hwmon/etc/wireview ]; then \
		chmod 700 debian/wireview-hwmon/etc/wireview; \
		chmod 600 debian/wireview-hwmon/etc/wireview/config; \
	fi

override_dh_auto_clean:
	rm -f wireviewd wireviewctl
