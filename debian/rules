#!/usr/bin/make -f

# Full hardening (adds bindnow to the fortify/stack-protector/PIE/relro
# defaults); dh_auto_build exports the resulting dpkg-buildflags and the
# Makefile's userspace rules consume CPPFLAGS/CFLAGS/LDFLAGS.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

WV_VERSION := $(strip $(shell cat VERSION))
DKMS_SRC := debian/wireview-hwmon-dkms/usr/src/wireview-hwmon-$(WV_VERSION)

%:
	dh $@

# Userspace only: the default "all" target would also build the kernel
# module, which DKMS does on the target machine instead.
override_dh_auto_build:
	dh_auto_build -- wireviewd wireviewctl

override_dh_auto_install:
	# Daemon package
	install -D -m 755 wireviewd debian/wireview-hwmon/usr/bin/wireviewd
	install -D -m 755 wireviewctl debian/wireview-hwmon/usr/bin/wireviewctl
	install -D -m 644 debian/wireviewd.service debian/wireview-hwmon/usr/lib/systemd/system/wireviewd.service
	install -D -m 644 99-wireview-hwmon.rules debian/wireview-hwmon/usr/lib/udev/rules.d/99-wireview-hwmon.rules
	install -D -m 644 firmware/TG-WV-PRO2-FW.hex debian/wireview-hwmon/usr/share/wireview/TG-WV-PRO2-FW.hex
	# Reference daemon config (conffile via dh_installdeb; may hold the HMAC secret)
	install -d -m 700 debian/wireview-hwmon/etc/wireview
	install -m 600 wireview-config.sample debian/wireview-hwmon/etc/wireview/config
	# DKMS package (version baked into dkms.conf and the module's MODULE_VERSION)
	install -D -m 644 wireview_hwmon.c $(DKMS_SRC)/wireview_hwmon.c
	sed 's/^PACKAGE_VERSION=.*/PACKAGE_VERSION="$(WV_VERSION)"/' dkms.conf > $(DKMS_SRC)/dkms.conf
	sed 's/@VERSION@/$(WV_VERSION)/' Makefile.dkms > $(DKMS_SRC)/Makefile

# dh_fixperms resets everything to go=rX; restore the private config perms.
override_dh_fixperms:
	dh_fixperms
	if [ -d debian/wireview-hwmon/etc/wireview ]; then \
		chmod 700 debian/wireview-hwmon/etc/wireview; \
		chmod 600 debian/wireview-hwmon/etc/wireview/config; \
	fi

override_dh_auto_clean:
	rm -f wireviewd wireviewctl
