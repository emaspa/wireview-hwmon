# /etc/wireview/config may hold the shared HMAC secret for remote writes, so
# the directory and the file are closed to others on purpose; the postinst
# gives them to the wireview group, whose members may edit the settings.
wireview-hwmon: non-standard-dir-perm 0750 != 0755 [etc/wireview/]
wireview-hwmon: non-standard-file-perm 0660 != 0644 [etc/wireview/config]
